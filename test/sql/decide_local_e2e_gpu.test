statement ok
CREATE OR REPLACE TABLE got_julia_1 AS SELECT id,
  decide_probability(text, 'A refund is requested.', model := 'julia-1') AS p_refund,
  decide_choice(text, 'Which team owns this?', ['billing', 'defect', 'account', 'shipping', 'other'], model := 'julia-1') AS team,
  decide_choice_distribution(text, 'Which team owns this?', ['billing', 'defect', 'account', 'shipping', 'other'], model := 'julia-1') AS team_dist,
  decide_score(text, 'How frustrated is the writer?', ['calm', 'frustrated', 'angry'], model := 'julia-1') AS mood,
  decide_probability(text, 'The writer is angry.', model := 'julia-1') AS p_angry,
  decide_decision(text, 'The writer is angry.', 0.5, model := 'julia-1') AS angry
FROM tickets;


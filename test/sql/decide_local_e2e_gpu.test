) t(id, text, refund, team, mood, lang);

statement ok
CREATE OR REPLACE TABLE got_laya_multilingual AS SELECT id,
  decide_probability(text, 'A refund is requested.', model := 'laya-multilingual') AS p_refund,
  decide_choice(text, 'Which team owns this?', ['billing', 'defect', 'account', 'shipping', 'other'], model := 'laya-multilingual') AS team,
  decide_choice_distribution(text, 'Which team owns this?', ['billing', 'defect', 'account', 'shipping', 'other'], model := 'laya-multilingual') AS team_dist,
  decide_score(text, 'How frustrated is the writer?', ['calm', 'frustrated', 'angry'], model := 'laya-multilingual') AS mood,
  decide_probability(text, 'The writer is angry.', model := 'laya-multilingual') AS p_angry,
  decide_decision(text, 'The writer is angry.', 0.5, model := 'laya-multilingual') AS angry
FROM tickets;


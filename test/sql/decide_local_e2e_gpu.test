statement ok
CREATE OR REPLACE TABLE got_laya_typed_decisions AS SELECT id,
  decide_probability(text, 'A refund is requested.', model := 'laya-typed-decisions') AS p_refund,
  decide_choice(text, 'Which team owns this?', ['billing', 'defect', 'account', 'shipping', 'other'], model := 'laya-typed-decisions') AS team,
  decide_choice_distribution(text, 'Which team owns this?', ['billing', 'defect', 'account', 'shipping', 'other'], model := 'laya-typed-decisions') AS team_dist,
  decide_score(text, 'How frustrated is the writer?', ['calm', 'frustrated', 'angry'], model := 'laya-typed-decisions') AS mood,
  decide_probability(text, 'The writer is angry.', model := 'laya-typed-decisions') AS p_angry,
  decide_decision(text, 'The writer is angry.', 0.5, model := 'laya-typed-decisions') AS angry
FROM tickets;


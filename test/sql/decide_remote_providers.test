# name: test/sql/decide_remote_providers.test
# description: Remote provider profiles (typesafe, liquid, systemone) and the
#              per-model options MAP. Registration and key/gate behaviour
#              only: hermetic, no network. Run with no API keys set.
# group: [anofox_decide]

require anofox_decide

statement ok
LOAD anofox_decide

# Jev and Liquid D1 register side by side (no SET between them needed).
query I
SELECT decide_register_model('jev-latest', 'typesafe')
----
1

query I
SELECT decide_register_model('d1:free', 'liquid')
----
1

query TT
SELECT provider, mode FROM decide_models() WHERE model IN ('jev-latest', 'd1:free') ORDER BY model
----
liquid	remote
typesafe	remote

# The generic System One provider needs an endpoint, and accepts a loopback one.
statement error
SELECT decide_register_model('kev-noendpoint', 'systemone')
----
<REGEX>:.*provider 'systemone' needs the address of your server.*

query I
SELECT decide_register_model('kev-latest', 'systemone', MAP {'endpoint': 'http://127.0.0.1:8009', 'key_env': 'KEV_TEST_KEY'})
----
1

# Options can pick a different wire model / path / endpoint for a known provider.
query I
SELECT decide_register_model('d1-alias', 'liquid', MAP {'model': 'd1:free', 'path': '/decisions/v1/systemone'})
----
1

# Cleartext http to a non-loopback host is refused at registration.
statement error
SELECT decide_register_model('bad-http', 'liquid', MAP {'endpoint': 'http://api.liquid.ai'})
----
<REGEX>:.*non-loopback.*

statement error
SELECT decide_register_model('bad-path', 'liquid', MAP {'path': 'no-leading-slash'})
----
<REGEX>:.*option 'path' must start with '/'.*

statement error
SELECT decide_register_model('bad-opt', 'liquid', MAP {'colour': 'blue'})
----
<REGEX>:.*unknown option 'colour'.*endpoint, path, model, key_env.*

# Options only apply to remote providers.
statement error
SELECT decide_register_model('opt-local', 'stub', MAP {'endpoint': 'https://x.example'})
----
<REGEX>:.*only applies to remote providers.*

# Unknown providers list the supported ones, including the new remote ones.
statement error
SELECT decide_register_model('nope', 'openai')
----
<REGEX>:.*not supported.*liquid.*systemone.*

# Calls stay behind the explicit allow_remote opt-in.
statement error
SELECT decide_probability('x', 'y', model := 'd1:free')
----
<REGEX>:.*model 'd1:free' is a Liquid AI model: calling it sends your text to https://api.liquid.ai, and remote calls are off.*

# With no key anywhere the error names the provider's own variable and the
# secret recipe (hermetic: env LIQUID_API_KEY is unset in CI).
statement ok
SET anofox_decide_allow_remote=true

statement error
SELECT decide_probability('x', 'y', model := 'd1:free')
----
<REGEX>:.*decide_probability: no API key for Liquid AI at api.liquid.ai\. Fix: provide a key: \(1\) export LIQUID_API_KEY=<key>.*CREATE SECRET.*SCOPE 'api.liquid.ai'.*

# A stored secret scoped to Liquid's host is never used for another provider's
# host: the typesafe model still has no key. (The positive case, a secret
# satisfying the D1 lookup, is covered with the real resolver in the Catch2
# [remote] tests.)
statement ok
CREATE SECRET liquid_test (TYPE anofox_decide, API_KEY 'sk-not-real', SCOPE 'api.liquid.ai')

statement error
SELECT decide_probability('x', 'y', model := 'jev-latest')
----
<REGEX>:.*no API key for TypeSafe at api.typesafe.ai.*

# --- strands-decider (keyless local server) ---------------------------------

query I
SELECT decide_register_model('strands-decider', 'strands')
----
1

query TT
SELECT provider, mode FROM decide_models() WHERE model = 'strands-decider'
----
strands	remote

# The criteria option picks how choice options are described on the wire.
query I
SELECT decide_register_model('strands-nulls', 'strands', MAP {'criteria': 'null'})
----
1

query I
SELECT decide_register_model('jev-names', 'typesafe', MAP {'criteria': 'name'})
----
1

statement error
SELECT decide_register_model('bad-criteria', 'strands', MAP {'criteria': 'maybe'})
----
<REGEX>:.*option 'criteria' must be 'null' or 'name', got 'maybe'.*

statement error
SELECT decide_register_model('stub-criteria', 'stub', MAP {'criteria': 'name'})
----
<REGEX>:.*only applies to remote providers.*

# A keyless provider needs no secret: the call goes straight to the network layer and fails on
# the connection, never on a missing key. Port 9 (discard) has no listener, so this is hermetic
# and does not depend on a real server being (or not being) on the default port.
query I
SELECT decide_register_model('strands-nowhere', 'strands', MAP {'endpoint': 'http://127.0.0.1:9'})
----
1

statement error
SELECT decide_probability('x', 'y', model := 'strands-nowhere')
----
<REGEX>:.*decide_probability: strands-decider at http://127.0.0.1:9 is not reachable: nothing is listening on 127.0.0.1:9 \(connection refused\)\. Fix: start the server on this machine.*

# --- Cloudflare Clef (Workers AI) ---

# The account id can be given per model; the model name is the wire model and part of the URL.
query I
SELECT decide_register_model('clef', 'cloudflare', MAP {'account_id': '0123456789abcdef0123456789abcdef'})
----
1

query T
SELECT endpoint FROM decide_models() WHERE model = 'clef'
----
https://api.cloudflare.com/client/v4/accounts/0123456789abcdef0123456789abcdef/ai/run/@cf/cloudflare/clef

statement error
SELECT decide_register_model('bad-account', 'cloudflare', MAP {'account_id': 'not-an-id'})
----
<REGEX>:.*option 'account_id' must be a 32-character Cloudflare account id, got 'not-an-id'.*

statement error
SELECT decide_register_model('wrong-provider', 'liquid', MAP {'account_id': '0123456789abcdef0123456789abcdef'})
----
<REGEX>:.*option 'account_id' only applies to provider 'cloudflare', but the provider is 'liquid'.*

# A typo in the option name gets a suggestion.
statement error
SELECT decide_register_model('typo', 'cloudflare', MAP {'acount_id': '0123456789abcdef0123456789abcdef'})
----
<REGEX>:.*unknown option 'acount_id'\. Did you mean 'account_id'\?.*

# With the account id given, the next missing piece is the token: the message names CLOUDFLARE_API_TOKEN
# (hermetic: the offline suite runs with the Cloudflare variables unset).
statement error
SELECT decide_probability('x', 'y', model := 'clef')
----
<REGEX>:.*no API key for Cloudflare Clef at api\.cloudflare\.com.*CLOUDFLARE_API_TOKEN.*

# Without an account id (no option, no CLOUDFLARE_ACCOUNT_ID) the call says exactly that, and so do the diagnostics.
query I
SELECT decide_register_model('clef-noacct', 'cloudflare')
----
1

statement error
SELECT decide_probability('x', 'y', model := 'clef-noacct')
----
<REGEX>:.*decide_probability: no Cloudflare account id for model 'clef-noacct'\. Fix: export CLOUDFLARE_ACCOUNT_ID=<id>.*MAP \{'account_id': '<id>'\}.*

query TT
SELECT ready, hint LIKE '%no Cloudflare account id for model ''clef-noacct''%' FROM decide_models() WHERE model = 'clef-noacct'
----
false	true

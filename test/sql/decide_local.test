# name: test/sql/decide_local.test
# description: Local NLI over the committed tiny fixture (julia1_tiny.onnx +
#              tiny_tokenizer.json). Random-init weights: asserts the typed
#              contract (finite probabilities, valid choices, determinism),
#              never specific values. Real-model values live in the gated
#              Catch2 test (JULIA_ONNX + JULIA_WEIGHTS_DIR).
# group: [anofox_decide]

require anofox_decide

statement ok
LOAD anofox_decide

# Local registration needs a graph path.
statement error
SELECT decide_register_model('nolocal', 'local')
----
<REGEX>:.*local models need the path of an ONNX graph file.*

query I
SELECT decide_register_model('tiny-local', 'local', 'test/fixtures/julia1_tiny.onnx', 'test/fixtures/tiny_tokenizer.json')
----
1

query I
SELECT count(*) FROM decide_models() WHERE model='tiny-local' AND provider='local' AND mode='local'
----
1

# Binary proposition: finite probability in [0,1].
query I
SELECT (p IS NOT NULL AND p >= 0.0 AND p <= 1.0)::INTEGER FROM (
  SELECT decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny-local') AS p
)
----
1

# Choice: top option is one of the options.
query I
SELECT (team IN ('billing','defect','other'))::INTEGER FROM (
  SELECT decide_choice('The bill is wrong.', 'Primary issue?', ['billing','defect','other'], model := 'tiny-local') AS team
)
----
1

# Batch: non-NULL JSON back, one request.
query I
SELECT (decide_many('The bill is wrong.', '[{"id":"refund","kind":"binary","instruction":"A refund is requested."},{"id":"dept","kind":"choice","instruction":"Team?","options":["billing","other"]}]', model := 'tiny-local') IS NOT NULL)::INTEGER
----
1

# Deterministic: same call twice gives the same probability.
query I
SELECT (a = b)::INTEGER FROM (
  SELECT decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny-local') AS a,
         decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny-local') AS b
)
----
1

# Local enforces the upstream option-count rule, in public vocabulary (no 2..20 interval, no validate_row).
statement error
SELECT decide_choice('x', 'y?', ['only-one'], model := 'tiny-local')
----
<REGEX>:.*decide_choice: the question has 1 option, but local models need 2 to 20\. Fix: give the question between 2 and 20 options.*

# Score over the tiny fixture (qtype 1): a finite expected level inside the
# rubric, deterministic across calls, and the per-level distribution sums to 1.
query I
SELECT (s BETWEEN 0.0 AND 2.0)::INTEGER FROM (
  SELECT decide_score('Help! My payouts are failing.', 'How frustrated is the writer?', ['calm','frustrated','angry'], model := 'tiny-local') AS s)
----
1

query I
SELECT decide_score('The bill is wrong.', 'How urgent?', ['low','high'], model := 'tiny-local')
     = decide_score('The bill is wrong.', 'How urgent?', ['low','high'], model := 'tiny-local')
----
true

query I
SELECT round(list_sum(map_values(distribution)), 6) FROM decide_table('The bill is wrong.',
  '[{"id":"f","kind":"score","instruction":"How urgent?","levels":["low","medium","high"]}]', model := 'tiny-local')
----
1.0

# Mixed batch: binary + choice + score in one local call keeps each row's own width.
query I
SELECT count(*) FROM decide_table('The bill is wrong.',
  '[{"id":"u","kind":"binary","instruction":"urgent?"},{"id":"t","kind":"choice","instruction":"team","options":["a","b"]},{"id":"f","kind":"score","instruction":"How urgent?","levels":["low","medium","high"]}]',
  model := 'tiny-local')
----
3

# --- Text that does not fit the window is an error, not a silent cut ---------------------------------

# decide_token_count: the cost of a text against the window, local models only.
query I
SELECT decide_token_count('ab ab ab', model := 'tiny-local') > 0
----
true

query I
SELECT decide_token_count(repeat('ab ', 9000), 'tiny-local') > 8192
----
true

query I
SELECT decide_token_count(NULL, 'tiny-local') IS NULL
----
true

statement error
SELECT decide_token_count('ab', model := 'stub')
----
<REGEX>:.*decide_token_count: the built-in 'stub' test model has no tokenizer.*

query I
SELECT decide_probability(repeat('ab ', 100), 'A refund is requested.', model := 'tiny-local') BETWEEN 0 AND 1
----
true

statement error
SELECT decide_probability(repeat('ab ', 9000), 'A refund is requested.', model := 'tiny-local')
----
<REGEX>:.*decide_probability: the text is \d+ tokens but the local model reads at most \d+ after the question and options \(anofox_decide_max_length = 8192\); \d+ tokens at the end would be ignored\. Fix: shorten the text, raise anofox_decide_max_length, use a model with a longer window, or SET anofox_decide_on_truncate = 'ignore'.*decide_token_count\(text\)\..*

# The question id is named when the call has several questions.
statement error
SELECT decide_many(repeat('ab ', 9000), '[{"id":"refund","kind":"binary","instruction":"A refund is requested."}]', model := 'tiny-local')
----
<REGEX>:.*decide_many: the text is \d+ tokens.*\(question 'refund'\).*

statement ok
SET anofox_decide_on_truncate = 'ignore'

query I
SELECT decide_probability(repeat('ab ', 9000), 'A refund is requested.', model := 'tiny-local') BETWEEN 0 AND 1
----
true

query I
SELECT current_setting('anofox_decide_on_truncate')
----
ignore

statement ok
RESET anofox_decide_on_truncate

query I
SELECT current_setting('anofox_decide_on_truncate')
----
error

statement error
SET anofox_decide_on_truncate = 'warn'
----
<REGEX>:.*anofox_decide_on_truncate: must be 'error' or 'ignore', got 'warn' \(default 'error'\)\. Fix: SET anofox_decide_on_truncate = 'ignore';.*

statement error
SET anofox_decide_on_truncate = NULL
----
<REGEX>:.*anofox_decide_on_truncate: the setting cannot be NULL.*

# name: test/sql/decide_contract.test
# description: anofox_decide scaffold contract (RED first). Extension loads and
#              exposes the MVP scalar surface with the BRD error contract.
# group: [anofox_decide]

require anofox_decide

statement ok
LOAD anofox_decide

# Registry lists at least the stub provider so model selection is explicit.
query I
SELECT count(*) FROM decide_models()
----
1

# Binary proposition returns a probability in [0,1], never a silent boolean.
query R
SELECT decide_probability('The customer requests a refund.', 'A refund is requested.', model := 'stub') AS p
----
0.5

# NULL state returns NULL by default.
query I
SELECT decide_probability(NULL, 'A refund is requested.', model := 'stub') IS NULL AS is_null
----
1

# Empty option sets are actionable errors, not empty results.
statement error
SELECT decide_choice('The bill is wrong.', 'Primary issue?', [], model := 'stub')
----
<REGEX>:.*non-empty option list.*

# NULL options are actionable errors, not silent NULLs.
statement error
SELECT decide_choice('The bill is wrong.', 'Primary issue?', [NULL, 'billing'], model := 'stub')
----
<REGEX>:.*must not contain NULL.*

# Non-text option lists are rejected at bind time (standard DuckDB
# no-match error suggesting an explicit cast); empty/NULL cases above get
# Decide-specific errors because they bind.
statement error
SELECT decide_choice('The bill is wrong.', 'Primary issue?', [1, 2], model := 'stub')
----
<REGEX>:.*No function matches.*

# Happy path returns the stub's first option.
query I
SELECT decide_choice('The bill is wrong.', 'Primary issue?', ['billing','defect','other'], model := 'stub')
----
billing

# decide_many stub: choice probability is the top-option probability 1.0
# (F12 pin: the DecideAnswer contract, shared with remote/local providers).
query I
SELECT (decide_many('x', '[{"id":"t","kind":"choice","instruction":"T?","options":["a","b"]}]', model := 'stub') LIKE '%"probability":1.0%')::INTEGER
----
1

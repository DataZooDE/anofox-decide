# Fitted on 60 rows by an independent optimiser (LBFGS + Newton in Python): a = 1.917975, b = -0.722736.
query I
SELECT decide_fit_calibration(p, y) LIKE 'platt:%,%' FROM labelled
----
true

query I
SELECT abs(split_part(replace(decide_fit_calibration(p, y), 'platt:', ''), ',', 1)::DOUBLE - 1.917975) < 1e-4 FROM labelled
----
true

query I
SELECT abs(split_part(replace(decide_fit_calibration(p, y), 'platt:', ''), ',', 2)::DOUBLE + 0.722736) < 1e-4 FROM labelled
----
true

# BIGINT outcomes give the same answer; NULL rows are skipped.
query I
SELECT decide_fit_calibration(p, y::BIGINT) = (SELECT decide_fit_calibration(p, y) FROM labelled) FROM labelled
----
true

query I
SELECT decide_fit_calibration(p, y) = (SELECT decide_fit_calibration(p, y) FROM labelled)
FROM (SELECT p, y FROM labelled UNION ALL SELECT NULL, true UNION ALL SELECT 0.3, NULL)
----
true

# The fitted spec registers, and calibration improves the Brier score on the data it was fitted on.
statement ok
SELECT decide_register_model('fitted', 'stub', MAP {'calibration': (SELECT decide_fit_calibration(p, y) FROM labelled)})

query I
SELECT calibration LIKE 'platt:%' FROM decide_models() WHERE model = 'fitted'
----
true

# Empty input returns NULL; grouped fits work and parallel combine is exercised by a larger input.
query I
SELECT decide_fit_calibration(p, y) IS NULL FROM labelled WHERE false
----
true

query I
SELECT count(*) FROM (SELECT g, decide_fit_calibration(p, y) AS spec FROM (SELECT p, y, i % 2 AS g FROM (SELECT p, y, row_number() OVER () AS i FROM labelled)) GROUP BY g)
----
2

query I
SELECT decide_fit_calibration(least(0.999, greatest(0.001, ((i * 7919) % 1000) / 1000.0)), ((i * 104729) % 1000) / 1000.0 < least(0.999, greatest(0.001, ((i * 7919) % 1000) / 1000.0))) LIKE 'platt:%'
FROM range(20000) t(i)
----
true

# --- fit errors are actionable -------------------------------------------------

statement error
SELECT decide_fit_calibration(p, true) FROM labelled
----
<REGEX>:.*same outcome \(true\).*needs both.*

statement error
SELECT decide_fit_calibration(0.5, y) FROM labelled
----
<REGEX>:.*all probabilities are identical.*

# Probabilities that rank outcomes backwards cannot be repaired by scaling.
statement error
SELECT decide_fit_calibration(1 - p, y) FROM labelled
----
<REGEX>:.*slope is not positive.*no better than chance.*

statement error
SELECT decide_fit_calibration(1.5, true)
----
<REGEX>:.*probability must be between 0 and 1.*

# --- decide_choice_distribution ---------------------------------------------------

query T
SELECT decide_choice_distribution('x', 'q', ['a', 'b', 'c'], model := 'stub')
----
{a=1.0, b=0.0, c=0.0}

query T
SELECT typeof(decide_choice_distribution('x', 'q', ['a', 'b'], model := 'stub'))
----
MAP(VARCHAR, DOUBLE)

# NULL contract mirrors decide_choice.
query I
SELECT decide_choice_distribution(NULL, 'q', ['a', 'b'], model := 'stub') IS NULL
----
true

query I
SELECT decide_choice_distribution('x', 'q', NULL::VARCHAR[], model := 'stub') IS NULL
----
true

statement error
SELECT decide_choice_distribution('x', 'q', [], model := 'stub')
----
<REGEX>:.*decide_choice_distribution: the options list is empty.*

statement error
SELECT decide_choice_distribution('x', 'q', ['a', NULL], model := 'stub')
----
<REGEX>:.*decide_choice_distribution: the options list contains NULL.*

# A real (tiny local) model: a proper distribution whose argmax is decide_choice's answer.
query I
SELECT abs(list_sum(map_values(decide_choice_distribution('The bill is wrong.', 'Which team?', ['billing', 'other'], model := 'tiny'))) - 1.0) < 1e-6
----
true

query I
SELECT map_keys(decide_choice_distribution('The bill is wrong.', 'Which team?', ['billing', 'other'], model := 'tiny'))
----
[billing, other]

query I
SELECT list_position(map_values(d), list_max(map_values(d))) = list_position(map_keys(d), decide_choice('The bill is wrong.', 'Which team?', ['billing', 'other'], model := 'tiny'))
FROM (SELECT decide_choice_distribution('The bill is wrong.', 'Which team?', ['billing', 'other'], model := 'tiny') AS d)
----
true

# Calibration never touches choice distributions.
query I
SELECT decide_choice_distribution('x', 'q', ['a', 'b'], model := 'stub-cal') = decide_choice_distribution('x', 'q', ['a', 'b'], model := 'stub')
----
true

# name: test/sql/decide_calibration_option.test
# description: Per-model Platt calibration of yes/no probabilities
#              (MAP {'calibration': 'platt:a,b'}), decide_fit_calibration, and
#              decide_choice_distribution. Hermetic: the stub answers a constant
#              0.5, so a calibrated stub is deterministic (sigmoid(b)), and the
#              tiny local fixture checks the same path through ONNX.
# group: [anofox_decide]

require anofox_decide

statement ok
LOAD anofox_decide

# --- registration ----------------------------------------------------------

query I
SELECT decide_register_model('stub-cal', 'stub', MAP {'calibration': 'platt:1,1'})
----
1

query I
SELECT decide_register_model('stub-cal2', 'stub', MAP {'calibration': 'platt:2,-0.5'})
----
1

# decide_models() shows the spec (NULL when uncalibrated).
query TT
SELECT model, calibration FROM decide_models() WHERE model IN ('stub', 'stub-cal', 'stub-cal2') ORDER BY model
----
stub	NULL
stub-cal	platt:1,1
stub-cal2	platt:2,-0.5

# --- effect on yes/no probabilities -----------------------------------------

# stub says 0.5 (logit 0): p' = sigmoid(b).
query I
SELECT round(decide_probability('x', 'y', model := 'stub'), 6)
----
0.5

query I
SELECT round(decide_probability('x', 'y', model := 'stub-cal'), 6)
----
0.731059

query I
SELECT round(decide_probability('x', 'y', model := 'stub-cal2'), 6)
----
0.377541

# The decision threshold sees the calibrated probability.
query I
SELECT decide_decision('x', 'y', 0.7, model := 'stub-cal')
----
true

query I
SELECT decide_decision('x', 'y', 0.7, model := 'stub')
----
false

# decide_many and decide_table go through the same path.
query I
SELECT round((regexp_extract(decide_many('x', '[{"id":"q","kind":"binary","instruction":"y"}]', model := 'stub-cal'), '"probability":([0-9.]+)', 1))::DOUBLE, 3)
----
0.731

query I
SELECT round(probability, 3) FROM decide_table('x', '[{"id":"q","kind":"binary","instruction":"y"}]', model := 'stub-cal')
----
0.731

# Choice answers are never calibrated.
query I
SELECT decide_choice('x', 'q', ['a', 'b'], model := 'stub-cal')
----
a

# --- invalid specs ------------------------------------------------------------

statement error
SELECT decide_register_model('bad1', 'stub', MAP {'calibration': 'platt:1'})
----
<REGEX>:.*option 'calibration' is invalid.*two numbers.*decide_fit_calibration.*

statement error
SELECT decide_register_model('bad2', 'stub', MAP {'calibration': 'platt:0,1'})
----
<REGEX>:.*slope a must be greater than 0.*

statement error
SELECT decide_register_model('bad3', 'stub', MAP {'calibration': 'platt:-1,0'})
----
<REGEX>:.*slope a must be greater than 0.*invert.*

statement error
SELECT decide_register_model('bad4', 'stub', MAP {'calibration': 'isotonic:1,2'})
----
<REGEX>:.*not a calibration spec.*platt.*

statement error
SELECT decide_register_model('bad5', 'stub', MAP {'calibration': 'platt:nan,1'})
----
<REGEX>:.*non-finite.*

# A failed registration leaves nothing behind.
query I
SELECT count(*) FROM decide_models() WHERE model LIKE 'bad%'
----
0

# --- remote and local registration accept it, and show it ---------------------

query I
SELECT decide_register_model('d1-cal', 'liquid', MAP {'model': 'd1:free', 'calibration': 'platt:0.8,-1.5'})
----
1

query T
SELECT calibration FROM decide_models() WHERE model = 'd1-cal'
----
platt:0.8,-1.5

query I
SELECT decide_register_model('tiny', 'local', 'test/fixtures/julia1_tiny.onnx', 'test/fixtures/tiny_tokenizer.json')
----
1

# The 6-argument form carries the options MAP for local models. a=1, b=0 is the identity.
query I
SELECT decide_register_model('tiny-id', 'local', 'test/fixtures/julia1_tiny.onnx', 'test/fixtures/tiny_tokenizer.json', 'julia-1', MAP {'calibration': 'platt:1,0'})
----
1

query I
SELECT decide_register_model('tiny-x2', 'local', 'test/fixtures/julia1_tiny.onnx', 'test/fixtures/tiny_tokenizer.json', 'julia-1', MAP {'calibration': 'platt:2,0'})
----
1

query I
SELECT abs(decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny-id') - decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny')) < 1e-9
----
true

# platt:2,0 sharpens: p' = sigmoid(2 * logit(p)) = p^2 / (p^2 + (1-p)^2).
query I
SELECT abs(
  decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny-x2') -
  (pow(decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny'), 2) /
   (pow(decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny'), 2) +
    pow(1 - decide_probability('The bill is wrong.', 'A refund is requested.', model := 'tiny'), 2)))) < 1e-6
----
true

# Local models keep their file/profile argument checks when a MAP is given.
statement error
SELECT decide_register_model('tiny-bad', 'local', 'test/fixtures/julia1_tiny.onnx', 'test/fixtures/tiny_tokenizer.json', 'nope', MAP {'calibration': 'platt:1,0'})
----
<REGEX>:.*profile 'nope' is not supported.*

